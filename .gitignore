# 依赖与锁文件（本工作区零依赖，无需 npm install）
node_modules
package.json
package-lock.json
pnpm-lock.yaml
bun.lock
yarn.lock
agent-manager.json

# 学生个人数据：运行期由脚本生成，不进模板仓库
学习数据/*.db
学习数据/*.db-journal
学习数据/*.db-wal
学习数据/*.db-shm
学习数据/待讲解.json

# 图片附件：只保留说明文件，学生存的图不进模板仓库
学习数据/图片/*
!学习数据/图片/README.md

# 升级前的本地备份（临时产物）
.upgrade-backup/

# 临时工作区：试卷原卷、待处理的中间文件，不进版本库
temp/

# Python 缓存
__pycache__/
*.pyc

# 知识库：独立仓库，clone 到 knowledge-base/ 目录。
# 整个目录不跟踪——否则两个仓库会互相冲突；内部结构由知识库仓库自己管。
knowledge-base/
知识库/

# 老师原件及知识库加工记录：知识库只保存处理后的教学内容
/原始资料/

# DSH 等 harness 的技能目录：本地建联接，不进库（内容在 .kilo/skills）
.agents/
